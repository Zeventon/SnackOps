# Defaults to <project root>/data. Use an absolute path for deployment.
SNACKOPS_DATA_DIR=
DEPLOY_RUN_PORT=5000

# Studio real model runtime. Secrets are only read on the server.
OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Alternative provider: DEEPSEEK_API_KEY, AI_BASE_URL and AI_MODEL.
# MCP credentials: set the named token variable here; UI stores only its name.
